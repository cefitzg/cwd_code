#Basic CWD model to study dependence on W
init S=15 II=0 E=0
 par  p3W=0.8 r=0.5 g=0.786 mu=0.567 K=230 eps=0.111 tau=2.55  
dS/dt=r*S*(1-S/K)-g*S*E-p3W*S/2 
dII/dt=g*S*E-mu*II-p3W*II 
dE/dt=eps*II-tau*E
@ TOTAL=100
@meth=cvode,bound=2000,xlo=0,ylo=-1,xhi=100,yhi=250,autoymax=250,autoymin=0,autoxmin=0,autoxmax=1,parmin=0,parmax=1
done#
